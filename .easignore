# Upload only the Expo app and its pnpm workspace inputs.
/*
!/.easignore
!/package.json
!/pnpm-lock.yaml
!/pnpm-workspace.yaml
!/apps
/apps/*
!/apps/mobile
/apps/mobile/*
!/apps/mobile/app.json
!/apps/mobile/eas.json
!/apps/mobile/index.ts
!/apps/mobile/package.json
!/apps/mobile/tsconfig.json
!/apps/mobile/assets
!/apps/mobile/src
!/apps/web
/apps/web/*
!/apps/web/package.json
!/apps/web/src
/apps/web/src/*
!/apps/web/src/lib
!/apps/web/src/components
/apps/web/src/components/*
!/apps/web/src/components/learn-ui
/apps/web/src/components/learn-ui/*
!/apps/web/src/components/learn-ui/lesson
/apps/web/src/components/learn-ui/lesson/*
!/apps/web/src/components/learn-ui/lesson/exercise-plan.ts
!/apps/web/src/components/learn-ui/lesson/sentence-plan.ts

**/node_modules/
**/.expo/
**/.env
**/.env.*
**/.evn
**/*.jks
**/*.keystore
