# Backend API base URL used by the frontend.
# This value is bundled into the client, so it must never contain secrets.
VITE_API_URL=http://127.0.0.1:8000

# Clerk publishable key from the Clerk dashboard. This value is public.
# Never put the Clerk secret key in this file or anywhere under apps/web.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your-publishable-key
