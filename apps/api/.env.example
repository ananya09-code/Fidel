# Server-side settings for the Fidel API. Copy to .env and adjust locally.
# Never commit the real .env -- it is gitignored.

# Postgres connection string (Neon or local).
DATABASE_URL=postgresql://user:password@localhost:5432/fidel

# JSON array of browser origins allowed to call the API.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

DEBUG=false

# Shared secret for the administrative audio-review endpoints.
# The review dashboard sends it in the X-Admin-Key header.
# When this is unset, every /api/audio-review endpoint refuses requests.
ADMIN_API_KEY=change-me

# Lifetime (seconds) of presigned audio URLs handed to the dashboard.
AUDIO_URL_EXPIRES_IN=3600

# Addis AI text-to-speech credentials.
ADDIS_API_KEY=change-me

# S3-compatible object storage for generated audio.
S3_ENDPOINT_URL=https://s3.example.com
S3_BUCKET_NAME=audio
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=change-me
AWS_SECRET_ACCESS_KEY=change-me

# Public base URL for stored audio (used by the legacy public route).
AUDIO_BASE_URL=https://cdn.example.com/audio

# Clerk authentication. CLERK_SECRET_KEY is server-only; never expose it to
# the browser. CLERK_ISSUER is required for token-issuer validation.
# CLERK_JWT_KEY is optional and, when set, enables offline JWT verification.
CLERK_SECRET_KEY=sk_test_change-me
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
# CLERK_JWT_KEY=optional-offline-verification-key
# Optional JSON array of allowed frontend origins for Clerk requests.
CLERK_AUTHORIZED_PARTIES=["http://localhost:3000"]
